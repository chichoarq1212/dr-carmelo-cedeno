{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "dr-carmelo-cedeno",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/org-logos/*"
    ]
  },
  "main": "src/index.js"
}
